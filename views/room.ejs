<!doctype html>
<%- include("head"); %>
<body id="room" class="noips regular">
  <nav id="main" class="layer">
    <div id="main-left">
      <button id="menu" class="i-menu"></button>
    </div>
    <h1 id="name"><%=NAME%> - <%=MOTTO%></h1>
    <div id="main-right"></div>
  </nav>

  <nav id="tools" class="layer">
    <div class="tools-row tools-filters-row" role="group" aria-label="File filters">
      <div class="btn-pill filter-pill">
      <button
        id="filter-image"
        class="filterbtn i-image-b"
        title="Filter Images"
      ></button>
      <button
        id="filter-video"
        class="filterbtn i-video-b"
        title="Filter Videos"
      ></button>
      <button
        id="filter-audio"
        class="filterbtn i-audio-b"
        title="Filter Audio"
      ></button>
      <button
        id="filter-document"
        class="filterbtn i-document-b"
        title="Filter Documents"
      ></button>
      <button
        id="filter-archive"
        class="filterbtn i-archive-b"
        title="Filter Archives"
      ></button>
      <button
        id="filter-file"
        class="filterbtn i-file-b"
        title="Filter other Files"
      ></button>
      <button
        id="filter-request"
        class="filterbtn i-question"
        title="Filter Requests"
      ></button>
      <button
        id="show-new-btn"
        class="btn i-arrow-up"
        title="Show only files newer than your last visit"
      ></button>
      </div>
      <div class="filter-field">
        <input
          id="filter"
          placeholder="Filter files…"
          type="text"
          autocomplete="off"
          required
        />
        <button
          type="button"
          id="filter-clear"
          class="disabled i-clear"
          title="Reset filters and show everything again"
          aria-label="Clear filter"
        ></button>
      </div>
      <div id="filter-status" class="hidden i-filter"></div>
      <div
        id="new-status"
        class="hidden blink i-arrow-up"
        title="New files at the top"
      ></div>
    </div>
    <div class="spacer"></div>
    <div class="tools-row tools-modes-row" role="group" aria-label="File modes and actions">
      <div class="btn-pill request-pill">
      <div id="createrequest" class="btn" title="Create Request">
        <span class="i-question"></span>
      </div>
      <div id="requestboard" class="btn" title="Request board">
        <span class="i-list"></span>
      </div>
    </div>
    <div class="btn-pill download-pill">
      <div
        id="downloadnew"
        class="btn btn-download"
        title="Download all new files"
      >
        <span class="i-arrow-down"></span>
        <span class="count-pill">0</span>
      </div>
      <div id="downloadall" class="btn btn-download" title="Download all files">
        <span class="i-download"></span>
        <span class="count-pill">0</span>
      </div>
    </div>
    <div class="btn-pill selection-pill">
      <div id="selectall" class="btn i-plus" title="Select all"></div>
      <div
        id="clearselection"
        class="btn i-clear"
        title="Clear selection"
      ></div>
      <div id="trash" class="btn i-trash" title="Remove files"></div>
    </div>
    <div id="banfiles" class="modctrl btn i-ban" title="Ban files"></div>
    <div id="unbanfiles" class="modctrl btn i-unban" title="Unban files"></div>
    <div
      id="blacklist"
      class="modctrl btn i-blacklist"
      title="Blacklist files"
    ></div>
    <div
      id="whitelist"
      class="modctrl btn i-whitelist"
      title="Whitelist files"
    ></div>
    <div class="btn-pill sort-pill">
      <div
        id="sort-newest"
        class="btn active"
        data-sort-mode="newest"
        title="Sort: Newest first"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 14 14"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M9.5 1 L4 8 H7 L4.5 13 L10 6 H7.5 Z" />
        </svg>
      </div>
      <div
        id="sort-largest"
        class="btn"
        data-sort-mode="largest"
        title="Sort: Largest first"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 14 14"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="0" y="2" width="3" height="12" />
          <rect x="4" y="5" width="3" height="9" />
          <rect x="8" y="8" width="3" height="6" />
          <rect x="11" y="11" width="3" height="3" />
        </svg>
      </div>
      <div
        id="sort-expiring"
        class="btn"
        data-sort-mode="expiring"
        title="Sort: Expiring soon"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 14 14"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="1" y="0" width="12" height="1.5" />
          <rect x="1" y="12.5" width="12" height="1.5" />
          <path d="M1 1.5 L13 1.5 L7 7 Z M7 7 L13 12.5 L1 12.5 Z" />
        </svg>
      </div>
    </div>
    <div class="btn-pill viewmode-pill">
      <div id="nailoff" class="btn i-list active" title="List view"></div>
      <div id="nailon" class="btn i-grid" title="Gallery view"></div>
      <div id="linkmode" class="btn" title="Links Archive">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
          />
          <path
            d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
          />
        </svg>
      </div>
    </div>
    <form style="display: none">
      <input
        id="upload-button"
        name="upload-button"
        type="file"
        multiple="multiple"
      />
    </form>
    <label for="upload-button" id="up" class="btn" title="Upload something!">
      <span class="i-upload"></span> Upload
    </label>
    </div>
  </nav>

  <nav id="presets-row" class="layer hidden">
    <div id="presets-list"></div>
    <button
      id="preset-save"
      class="btn i-plus"
      title="Save current filter as preset"
    ></button>
  </nav>

  <section id="chat" class="layer">
    <section id="messages"></section>
  </section>
  <section id="chat-scroller" class="scroller hidden"></section>

  <section id="status" class="layer">
    <div
      id="endmarker"
      class="blink hidden i-arrow-down"
      title="Go to new messages"
    ></div>
    <div id="ips" class="modctrl">IP</div>
    <div id="connection" class="visible i-warning" title="No connection"></div>
    <div id="usercountcont" title="Users online">
      <span id="usercount-icon" class="i-users"></span>
      <span id="usercount">0</span>
    </div>
    <div>
      <span id="user-icon" class="i-white" title="Unregistered"></span>
      <input type="text" id="nick" />
    </div>
  </section>

  <section id="chatbox" class="layer">
    <textarea
      id="text"
      data-placeholder-enabled="Chat…"
      data-placeholder-disabled="You need to log in to chat and upload files!"
      data-placeholder-disconnected="Currently not connected."
      rows="3"
      maxlength="300"
    ></textarea>
  </section>

  <section id="splitter" class="layer"></section>

  <section id="dropminder" class="layer">
    <svg
      version="1.1"
      viewBox="-25 -25 1050 1050"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect
        width="1e3"
        height="1e3"
        rx="1e2"
        fill="none"
        stroke="#434343"
        stroke-dasharray="0, 600, 360, 0"
        stroke-dashoffset="-100"
        stroke-width="50px"
      />
      <text
        id="dropper"
        x="510"
        y="284.49219"
        fill="#434343"
        font-family="'Rubik'"
        font-size="240px"
        font-weight="bold"
        text-anchor="middle"
      >
        <tspan x="510" y="285">Drop</tspan>
        <tspan x="510" y="585">stuff</tspan>
        <tspan x="510" y="885">here</tspan>
      </text>
    </svg>
  </section>

  <section id="filelist" class="layer">
    <section
      id="continuity"
      class="hidden"
      aria-label="Continue and discover room activity"
    >
      <div id="continuity-actions">
        <button id="continuity-resume" class="hidden" type="button">
          <span class="continuity-kicker">Continue reading</span>
          <span id="continuity-resume-name"></span>
        </button>
        <div id="continuity-digest-control" class="hidden">
          <button
            id="continuity-digest-toggle"
            type="button"
            aria-expanded="false"
          >
            <span class="continuity-kicker">Since your last visit</span>
            <span id="continuity-digest-count"></span>
          </button>
          <button
            id="continuity-download-all"
            class="i-download"
            type="button"
            title="Download all uploads since your last visit"
            aria-label="Download all uploads since your last visit"
          ></button>
        </div>
        <button
          id="continuity-mark-seen"
          class="hidden i-clear"
          type="button"
          title="Mark seen"
          aria-label="Mark seen"
        ></button>
      </div>
      <div id="continuity-digest" class="hidden"></div>
    </section>
    <section id="files" class="listmode"></section>
    <section id="links" class="listmode hidden">
      <div id="links-header">
        <span class="lh-name">Title / URL</span>
        <span class="lh-tags">Shared by</span>
        <span class="lh-detail">Age</span>
      </div>
    </section>
  </section>
  <section id="filelist-scroller" class="scroller hidden"></section>

  <section id="gallery" class="layer">
    <img id="gallery_img" alt="" src="/loader.png" />
    <span id="gallery_title" class="gallery_text">title</span>
    <a id="gallery_close" class="i-clear"></a>
    <a id="gallery_download" class="i-download" title="Download file"></a>
    <a id="gallery_prev" class="gallery_prevnext i-prev"></a>
    <a id="gallery_next" class="gallery_prevnext i-next"></a>
    <span id="gallery_info" class="gallery_text">shrekt kek</span>
    <button
      id="gallery_read_now"
      class="gallery-read-now hidden"
      type="button"
      title="Open in-page reader (R)"
    >
      Read Now
    </button>
  </section>

  <section id="reader" class="layer">
    <div id="reader-bar">
      <a id="reader-close" class="i-clear" title="Close reader"></a>
      <span id="reader-title"></span>
      <span id="reader-info"></span>
      <div class="reader-zoom-pill">
        <button id="reader-zoom-out" title="Zoom out">&#8722;</button>
        <button id="reader-zoom-in" title="Zoom in">&#43;</button>
      </div>
      <div id="reader-view-pill" class="hidden reader-view-pill">
        <button
          id="reader-manga"
          class="reader-view-btn"
          title="Manga mode — right-to-left page order"
        >
          漫 Manga</button
        ><button
          id="reader-webtoon"
          class="reader-view-btn"
          title="Webtoon mode — continuous vertical scroll"
        >
          &#8597; Webtoon
        </button>
      </div>
      <button id="reader-opts" class="hidden" title="Reader options">Aa</button>
      <button id="reader-fullscreen" title="Focus reading mode (F)">
        &#9974;
      </button>
      <a id="reader-download" class="i-download" title="Download file"></a>
      <button id="reader-prev" class="hidden" title="Previous chapter">
        &lsaquo; Prev
      </button>
      <button id="reader-next" class="hidden" title="Next chapter">
        Next &rsaquo;
      </button>
    </div>
    <div id="reader-content"></div>
    <div id="reader-opts-modal" class="hidden">
      <div class="rom-section">
        <div class="rom-label">Font</div>
        <div class="rom-fonts">
          <button
            class="rom-font-btn"
            data-font="georgia"
            title="Georgia (serif)"
          >
            <span style="font-family: Georgia, serif">Ag</span
            ><small>Georgia</small>
          </button>
          <button
            class="rom-font-btn"
            data-font="bookerly"
            title="Bookerly (Kindle)"
          >
            <span
              style="
                font-family:
                  &quot;Bookerly&quot;, &quot;Palatino Linotype&quot;,
                  &quot;Palatino&quot;, serif;
              "
              >Ag</span
            ><small>Bookerly</small>
          </button>
          <button
            class="rom-font-btn"
            data-font="helvetica"
            title="Helvetica (sans-serif)"
          >
            <span style="font-family: Helvetica, Arial, sans-serif">Ag</span
            ><small>Helvetica</small>
          </button>
          <button
            class="rom-font-btn"
            data-font="dyslexic"
            title="OpenDyslexic (accessibility)"
          >
            <span
              style="
                font-family: OpenDyslexic, &quot;Comic Sans MS&quot;, cursive;
              "
              >Ag</span
            ><small>OpenDyslexic</small>
          </button>
        </div>
      </div>
      <div class="rom-section">
        <div class="rom-label">Font size</div>
        <div class="rom-row">
          <button
            id="rom-size-dec"
            class="rom-step-btn"
            title="Decrease font size"
          >
            A&#8722;
          </button>
          <span id="rom-size-val"></span>
          <button
            id="rom-size-inc"
            class="rom-step-btn"
            title="Increase font size"
          >
            A&#43;
          </button>
        </div>
      </div>
      <div class="rom-section">
        <div class="rom-label">Line spacing</div>
        <div class="rom-row rom-choices" id="rom-spacing-row">
          <button class="rom-choice-btn" data-spacing="1.4" title="Compact">
            &#8803; Compact
          </button>
          <button class="rom-choice-btn" data-spacing="1.75" title="Normal">
            &#8803; Normal
          </button>
          <button class="rom-choice-btn" data-spacing="2.2" title="Relaxed">
            &#8803; Relaxed
          </button>
        </div>
      </div>
      <div class="rom-section">
        <div class="rom-label">Margins</div>
        <div class="rom-row rom-choices" id="rom-margin-row">
          <button class="rom-choice-btn" data-margin="40" title="Narrow">
            Narrow
          </button>
          <button class="rom-choice-btn" data-margin="56" title="Normal">
            Normal
          </button>
          <button class="rom-choice-btn" data-margin="72" title="Wide">
            Wide
          </button>
        </div>
      </div>
    </div>
  </section>

  <div id="preload"></div>

  <ul id="context-menu" style="display: none">
    <li id="ctx-home" data-icon="i-sytem32">Home</li>
    <li id="ctx-newroom" data-icon="i-newroom">New Room</li>
    <li id="ctx-roomlist" data-class="modctrl" data-icon="i-sytem32">
      Room List
    </li>
    <li>-</li>
    <li id="ctx-report" data-icon="i-report">Report this Room!</li>
    <li id="ctx-options" data-icon="i-edit">Room Options</li>
    <li id="ctx-notifications" data-icon="i-pref">Notifications</li>
    <li id="ctx-ban" data-class="modctrl" data-icon="i-ban">Ban</li>
    <li id="ctx-unban" data-class="modctrl" data-icon="i-unban">Unban</li>
    <li id="ctx-nuke" data-class="modctrl" data-icon="i-nuke">
      Nuke this Room!
    </li>
    <li id="ctx-modlog" data-class="modctrl" data-icon="i-sytem32">
      Moderation Log
    </li>
    <li>-</li>
    <li id="ctx-register" data-icon="i-users">Register</li>
    <li id="ctx-login" data-icon="i-login">Log In</li>
    <li id="ctx-account" data-icon="i-white">Account</li>
    <li id="ctx-logout" data-icon="i-logout">Log Out</li>
  </ul>

  <form id="login-tmpl" class="tmpl">
    <span class="icon i-login"></span>
    <label>User:</label>
    <input name="u" type="text" autocomplete="username" />
    <label>Password:</label>
    <input name="p" type="password" autocomplete="current-password" />
    <label class="tfa-label hidden">Two factor:</label>
    <input class="tfa hidden" name="t" type="text" autocomplete="off" />
  </form>

  <form id="report-tmpl" class="tmpl">
    <span class="icon i-report" aria-hidden="true"></span>
    <section id="report-rules">
      <h4>Report rules</h4>
      <ul>
        <li>Send one report. Repeated reports are treated as spam.</li>
        <li>
          Use this form only for clearly illegal content or clear violations of
          the site rules. Copyright claims are not handled here.
        </li>
        <li>
          Content may be restricted in your jurisdiction without being illegal
          everywhere.
        </li>
        <li>For anything else, use the normal support channels.</li>
        <li>Describe what is wrong and where it appears.</li>
      </ul>
    </section>
    <div class="report-fields">
      <label for="report-room">Room</label>
      <input
        id="report-room"
        name="room"
        type="text"
        readonly
        aria-readonly="true"
      />
      <label for="report-message">Report message</label>
      <textarea
        id="report-message"
        name="msg"
        rows="5"
        maxlength="2000"
        required
        placeholder="Describe the content and the rule it violates…"
      ></textarea>
    </div>
    <label id="report-agreement">
      <input
        id="report-agreement-checkbox"
        type="checkbox"
        name="agreement"
      />
      <span>
        I followed these rules and understand that abusing reports may result
        in a ban.
      </span>
    </label>
    <p id="report-error" class="report-error" role="alert" hidden></p>
  </form>

  <form id="changepw-tmpl" class="tmpl">
    <span class="icon i-login"></span>
    <label>Username:</label>
    <input name="u" type="text" disabled autocomplete="username" />
    <label>Current password:</label>
    <input name="c" type="password" autocomplete="current-password" />
    <label>New Password:</label>
    <input name="p" type="password" autocomplete="new-password" />
    <label>Confirm New Password:</label>
    <input name="confirmation" type="password" autocomplete="new-password" />
    <label class="tfa-label hidden">Two factor:</label>
    <input class="tfa hidden" name="t" type="text" autocomplete="off" />
  </form>

  <form id="ban-tmpl" class="tmpl">
    <span class="icon i-ban"></span>
    <label>Subjects</label>
    <input name="s" type="text" autocomplete="off" />
    <label>Make them suffer!</label>
    <label><input type="checkbox" name="mute" /> Mute</label>
    <label></label>
    <label><input type="checkbox" name="upload" /> Ban uploads</label>
    <label></label>
    <label><input type="checkbox" name="hellban" /> Hellban</label>
    <label></label>
    <label><input type="checkbox" name="purge" /> Purge Files</label>
    <label>Duration (in hours)</label>
    <input name="hours" type="text" autocomplete="off" />
    <label>Reason</label>
    <textarea name="reason" cols="20" rows="4"></textarea>
    <label>Template</label>
    <select name="templates"></select>
  </form>

  <form id="bl-tmpl" class="tmpl">
    <span class="icon i-blacklist"></span>
    <label>Make them suffer!</label>
    <label><input type="checkbox" name="mute" /> Mute</label>
    <label></label>
    <label><input type="checkbox" name="upload" /> Ban uploads</label>
    <label></label>
    <label><input type="checkbox" name="hellban" /> Hellban</label>
    <label>Duration (in hours)</label>
    <input name="hours" type="text" autocomplete="off" />
    <label>Reason</label>
    <textarea name="reason" cols="20" rows="4"></textarea>
    <label>Template</label>
    <select name="templates"></select>
  </form>

  <form id="unban-tmpl" class="tmpl">
    <span class="icon i-unban"></span>
    <label>Subjects</label>
    <input name="s" type="text" autocomplete="off" />
    <label></label>
    <label><input type="checkbox" name="mute" checked /> Unmute</label>
    <label></label>
    <label><input type="checkbox" name="upload" checked /> Allow uploads</label>
    <label></label>
    <label><input type="checkbox" name="hellban" checked /> Un-hellban</label>
    <label>Reason</label>
    <textarea name="reason" cols="20" rows="4"></textarea>
  </form>

  <form id="roomopts-tmpl" class="tmpl">
    <div class="roomopts-shell">
      <div class="roomopts-tabs" role="tablist">
        <button
          type="button"
          class="roomopts-tab active"
          data-roomopts-tab="general"
          role="tab"
          aria-selected="true"
        >
          General
        </button>
        <button
          type="button"
          class="roomopts-tab"
          data-roomopts-tab="invites"
          role="tab"
          aria-selected="false"
        >
          Invites
        </button>
        <button
          type="button"
          class="roomopts-tab"
          data-roomopts-tab="linking"
          role="tab"
          aria-selected="false"
        >
          Linking
        </button>
        <button
          type="button"
          class="roomopts-tab"
          data-roomopts-tab="plugins"
          role="tab"
          aria-selected="false"
        >
          Plugins
        </button>
        <button
          type="button"
          class="roomopts-help-btn hidden"
          name="linkhelpbtn"
          title="How multi-room linking works"
          aria-label="Help: multi-room linking"
        >
          ?
        </button>
      </div>

      <div
        class="roomopts-panel roomopts-panel-general"
        data-roomopts-panel="general"
        role="tabpanel"
      >
        <div class="roomopts-section">
          <div class="roomopts-field">
            <label for="roomopts-name">Room name</label>
            <input
              id="roomopts-name"
              name="name"
              type="text"
              autocomplete="off"
            />
          </div>
          <div class="roomopts-field">
            <label for="roomopts-motd">Message of the day</label>
            <textarea
              id="roomopts-motd"
              name="motd"
              cols="20"
              rows="3"
            ></textarea>
          </div>
          <div class="roomopts-actions">
            <button type="button" name="owners">Manage owners</button>
            <button type="button" class="hidden" name="invitees">
              Manage invited users
            </button>
          </div>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-section-title">Room features</div>
          <div class="roomopts-checks">
            <label
              ><input type="checkbox" name="inviteonly" /> Invite-only</label
            >
            <label
              ><input type="checkbox" name="adult" /> Adult content</label
            >
            <label
              ><input type="checkbox" name="allowrequests" /> Allow
              requests</label
            >
            <label
              ><input type="checkbox" name="linkcollection" /> Link
              collection</label
            >
            <label
              ><input type="checkbox" name="deeplinks" /> Shareable deep
              links</label
            >
            <label class="roomopts-check-with-help">
              <input type="checkbox" name="allowcrosslinking" />
              <span>Allow room cross-linking</span>
              <button
                type="button"
                class="roomopts-inline-help"
                name="crosslinkhelpbtn"
                title="What is room cross-linking?"
                aria-label="Help: Allow room cross-linking"
                aria-expanded="false"
                aria-controls="roomopts-crosslink-help"
              >
                ?
              </button>
            </label>
            <label>
              <input type="checkbox" name="allowprivatecrosslinking" />
              Allow private linking
            </label>
            <label>
              <input type="checkbox" name="allowfederation" />
              Allow trusted peer federation
            </label>
            <label>
              <input type="checkbox" name="allowprivatefederation" />
              Allow federation for this private room
            </label>
          </div>
          <p
            id="roomopts-crosslink-help"
            class="roomopts-hint roomopts-crosslink-help hidden"
            name="crosslinkhelp"
            role="note"
          >
            <strong>Allow room cross-linking</strong> is an opt-in on
            <em>this</em> room so other rooms can mirror its finished uploads.
            Invite-only rooms also require
            <strong>Allow private linking</strong>. To pull
            private files <em>into</em> this room, the destination link must
            request private-source access too.
          </p>
        </div>

        <div class="roomopts-section modctrl">
          <div class="roomopts-section-title">Moderator</div>
          <div class="roomopts-checks roomopts-checks-mod">
            <label
              ><input type="checkbox" name="disabled" /> Disabled</label
            >
            <label
              ><input type="checkbox" name="disablereports" /> Disable
              reports</label
            >
          </div>
          <div class="roomopts-field roomopts-field-inline">
            <label for="roomopts-ttl">File TTL (hours)</label>
            <input
              id="roomopts-ttl"
              name="ttl"
              type="number"
              autocomplete="off"
              min="0"
              max="168"
            />
          </div>
        </div>
      </div>

      <div
        class="roomopts-panel roomopts-panel-linking hidden"
        data-roomopts-panel="linking"
        role="tabpanel"
      >
        <div
          class="roomopts-link-help hidden"
          name="linkhelp"
          role="region"
          aria-label="Linking help"
        >
          <div class="roomopts-link-help-head">
            <strong>How multi-room linking works</strong>
            <button type="button" name="linkhelpclose" class="roomopts-help-close">
              Close
            </button>
          </div>
          <div class="roomopts-link-help-body">
            <p>
              Linking makes finished uploads from another room appear in
              <em>this</em> room’s file list (marked as linked). Files are not
              copied — open/download still uses the source room. Delete and
              moderation stay with the source.
            </p>
            <p><strong>Two sides of the setup</strong></p>
            <ol>
              <li>
                <strong>Source room</strong> (General tab): enable
                <em>Allow room cross-linking</em>. Without this, knowing the
                room id or name is not enough — nothing is mirrored.
              </li>
              <li>
                <strong>Destination room</strong> (this Linking tab): add the
                source by room id or exact room name, then optional filters.
              </li>
            </ol>
            <p><strong>Status column</strong></p>
            <ul>
              <li><em>Active</em> — source exists and allows cross-linking.</li>
              <li>
                <em>Cross-link off</em> — source has not opted in (row stays;
                zero files until fixed).
              </li>
              <li>
                <em>Private source</em> — source is invite-only; explicitly
                allow private-source mirroring on that link before rows appear.
              </li>
              <li><em>Missing</em> — room id not found.</li>
            </ul>
            <p><strong>Filters / rules (Edit on a row)</strong></p>
            <ul>
              <li>
                Filename, tag, and uploader username rules support comma or
                <code>OR</code>, <code>AND</code>, and regular expressions
              </li>
              <li>Tag rules match any tag key or value</li>
              <li>File types — image, video, document, … (empty = all)</li>
              <li>No older than (hours) — only recent uploads</li>
              <li>At least this old (hours) — only older uploads</li>
              <li>
                Visibility — everyone, signed-in users, room members/guests,
                room owners, or moderators
              </li>
            </ul>
            <p><strong>Examples</strong></p>
            <ul>
              <li>
                Hub room pulls every PDF from “Campaign Maps”: add that room,
                Edit → type <em>Document</em> only.
              </li>
              <li>
                Only maps uploaded this week: filename contains
                <code>map</code>, no older than <code>168</code> hours.
              </li>
              <li>
                Archive dump, ignore brand-new drops: at least
                <code>24</code> hours old.
              </li>
            </ul>
          </div>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-link-add">
            <input
              name="linkaddtoken"
              type="text"
              autocomplete="off"
              placeholder="Room id or exact name"
              aria-label="Source room id or name"
            />
            <button type="button" name="linkaddbtn">Add link</button>
          </div>
          <div class="roomopts-link-table-wrap">
            <table class="roomopts-link-table">
              <thead>
                <tr>
                  <th>Source</th>
                  <th>Status</th>
                  <th>Filters / rules</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody name="linktbody"></tbody>
            </table>
            <p class="roomopts-link-empty hidden" name="linkempty">
              No linked rooms yet. Add a source by id or exact name above.
            </p>
          </div>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-section-title">Federated peer rooms</div>
          <p class="roomopts-hint">
            Add a room from a trusted peer configured by this server’s
            operator. Files stay on the source host and are streamed through
            this Dicefiles server.
          </p>
          <div class="roomopts-link-add">
            <select
              name="federationpeer"
              aria-label="Trusted federation peer"
            ></select>
            <input
              name="federationroom"
              type="text"
              autocomplete="off"
              placeholder="Remote room id"
              aria-label="Remote room id"
            />
            <button type="button" name="federationaddbtn">Add peer room</button>
          </div>
          <div class="roomopts-link-table-wrap">
            <table class="roomopts-link-table">
              <thead>
                <tr>
                  <th>Peer / room</th>
                  <th>Status</th>
                  <th>Filters / rules</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody name="federationtbody"></tbody>
            </table>
            <p class="roomopts-link-empty hidden" name="federationempty">
              No federated peer rooms yet.
            </p>
          </div>
        </div>

        <div class="roomopts-link-editor hidden" name="linkeditor">
          <div class="roomopts-link-editor-title">
            Edit rules —
            <span name="linkeditorlabel"></span>
          </div>
          <details class="roomopts-rule-syntax-help">
            <summary>
              Rule syntax <span aria-hidden="true">(?)</span>
            </summary>
            <div>
              <p>
                Use commas or uppercase <code>OR</code> to match any term:
                <code>map, dungeon</code> or <code>map OR dungeon</code>.
                Use uppercase <code>AND</code> to require every term:
                <code>pf2 AND remaster</code>. AND is evaluated before OR.
              </p>
              <p>
                For complex matching, enter a JavaScript-style regular
                expression such as <code>/^pf2.*\.pdf$/i</code>. You can
                combine regex with AND and OR. Filename, tag, and uploader
                fields must all match when more than one field is filled.
              </p>
              <p>
                If you do not know regex, you can ask an AI to convert your
                desired outcome into a regex, then review it before saving.
              </p>
            </div>
          </details>
          <div class="roomopts-field">
            <label for="roomopts-rule-name">Filename rule</label>
            <input
              id="roomopts-rule-name"
              name="rule_name"
              type="text"
              autocomplete="off"
              placeholder="Comma, AND, OR, or /regex/i"
            />
          </div>
          <div class="roomopts-field">
            <label for="roomopts-rule-tag">Tag rule</label>
            <input
              id="roomopts-rule-tag"
              name="rule_tag"
              type="text"
              autocomplete="off"
              placeholder="Comma, AND, OR, or /regex/i"
            />
          </div>
          <div class="roomopts-field">
            <label for="roomopts-rule-user">Uploader username rule</label>
            <input
              id="roomopts-rule-user"
              name="rule_user"
              type="text"
              autocomplete="off"
              placeholder="Comma, AND, OR, or /regex/i"
            />
          </div>
          <p
            name="linkruleerror"
            class="roomopts-rule-error hidden"
            role="alert"
          ></p>
          <fieldset class="roomopts-link-types">
            <legend>File types (none selected = all types)</legend>
            <div class="roomopts-link-types-grid">
              <label
                ><input type="checkbox" name="rule_type_image" value="image" />
                Image</label
              >
              <label
                ><input type="checkbox" name="rule_type_video" value="video" />
                Video</label
              >
              <label
                ><input type="checkbox" name="rule_type_audio" value="audio" />
                Audio</label
              >
              <label
                ><input
                  type="checkbox"
                  name="rule_type_document"
                  value="document"
                />
                Document</label
              >
              <label
                ><input
                  type="checkbox"
                  name="rule_type_archive"
                  value="archive"
                />
                Archive</label
              >
              <label
                ><input type="checkbox" name="rule_type_file" value="file" />
                Other file</label
              >
            </div>
          </fieldset>
          <div class="roomopts-link-age">
            <div class="roomopts-field">
              <label for="roomopts-rule-maxage">No older than (hours)</label>
              <input
                id="roomopts-rule-maxage"
                name="rule_maxage"
                type="number"
                min="0"
                step="1"
                placeholder="any"
              />
            </div>
            <div class="roomopts-field">
              <label for="roomopts-rule-minage">At least this old (hours)</label>
              <input
                id="roomopts-rule-minage"
                name="rule_minage"
                type="number"
                min="0"
                step="1"
                placeholder="any"
              />
            </div>
          </div>
          <div class="roomopts-link-access">
            <div class="roomopts-field">
              <label for="roomopts-link-visibility">Visible to</label>
              <select id="roomopts-link-visibility" name="linkvisibility">
                <option value="all">Everyone</option>
                <option value="authenticated">Signed-in users</option>
                <option value="members">Room members and invited guests</option>
                <option value="owners">Room owners</option>
                <option value="mods">Moderators only</option>
              </select>
            </div>
            <label
              class="roomopts-invite-check roomopts-link-private"
              name="linkprivatecontainer"
            >
              <input type="checkbox" name="linkprivate" />
              Request private-source access for this link
            </label>
            <p class="roomopts-hint" name="linkprivatehint">
              The invite-only source room must separately allow private
              cross-linking. Both rooms must consent.
            </p>
            <p class="roomopts-hint">
              Hidden and hellbanned source uploads never cross room boundaries,
              including for moderators.
            </p>
          </div>
          <div class="roomopts-plugin-operations" name="pluginoperations">
            <div class="roomopts-plugin-operation">
              <span class="roomopts-plugin-operation-label">Last run</span>
              <span name="pluginrunstate">Never run</span>
            </div>
            <div class="roomopts-plugin-operation" name="pluginsyncrow">
              <span class="roomopts-plugin-operation-label">Import memory</span>
              <span name="pluginsyncstate">Loading…</span>
              <div class="roomopts-plugin-operation-actions">
                <button type="button" name="pluginsyncrefresh">Refresh</button>
                <button type="button" name="pluginsyncclear">Forget imports</button>
              </div>
            </div>
          </div>
          <div class="roomopts-link-editor-actions">
            <button type="button" name="linkeditorapply">Apply rules</button>
            <button type="button" name="linkeditorclear">Clear rules</button>
            <button type="button" name="linkeditorsclose">Close</button>
          </div>
        </div>
        <input type="hidden" name="linkedrooms" value="" />
      </div>

      <div
        class="roomopts-panel roomopts-panel-invites hidden"
        data-roomopts-panel="invites"
        role="tabpanel"
      >
        <div class="roomopts-section">
          <div class="roomopts-section-title">Guest invite links</div>
          <p class="roomopts-hint">
            Shareable links for invite-only rooms. Guests redeem once (or up to
            your limit) and do not become owners. Enable
            <strong>Invite-only</strong> on the General tab for links to gate
            access.
          </p>

          <div class="roomopts-invite-gen">
            <label class="roomopts-invite-gen-label" for="roomopts-inviteurl"
              >Generated link</label
            >
            <div class="roomopts-invite-gen-row">
              <div class="roomopts-invite-field">
                <input
                  id="roomopts-inviteurl"
                  name="inviteurlfield"
                  type="text"
                  readonly
                  autocomplete="off"
                  placeholder="Generate a guest invite link…"
                  aria-label="Generated guest invite link"
                />
                <button
                  type="button"
                  class="roomopts-invite-copy icon i-copy"
                  name="invitecopy"
                  title="Copy link"
                  aria-label="Copy invite link to clipboard"
                  hidden
                  disabled
                ></button>
              </div>
              <button
                type="button"
                class="roomopts-invite-limits-btn"
                name="invitelimitsbtn"
                title="Set limits and generate"
                aria-label="Open limits panel to generate invite"
                aria-expanded="false"
                aria-controls="roomopts-invite-limits"
              >
                Generate
              </button>
            </div>
          </div>

          <div
            id="roomopts-invite-limits"
            class="roomopts-invite-limits-panel hidden"
            name="invitelimitspanel"
            role="region"
            aria-label="Invite link limits"
          >
            <div class="roomopts-link-editor-title">Invite limits</div>
            <p class="roomopts-hint">
              Choose single-use, max redemptions, and/or a time limit, then
              create the link.
            </p>
            <label class="roomopts-invite-check"
              ><input type="checkbox" name="invitesingle" checked />
              Single-use (exactly one redeem)</label
            >
            <div class="roomopts-link-age">
              <div class="roomopts-field">
                <label for="roomopts-invitemax">Max users (X)</label>
                <input
                  id="roomopts-invitemax"
                  name="invitemax"
                  type="number"
                  min="1"
                  max="10000"
                  value="1"
                />
              </div>
              <div class="roomopts-field">
                <label for="roomopts-invitehours">Max age (hours)</label>
                <input
                  id="roomopts-invitehours"
                  name="invitehours"
                  type="number"
                  min="0"
                  step="1"
                  placeholder="optional"
                />
              </div>
            </div>
            <div class="roomopts-field">
              <label for="roomopts-invitelabel">Label (optional)</label>
              <input
                id="roomopts-invitelabel"
                name="invitelabel"
                type="text"
                autocomplete="off"
                placeholder="e.g. Saturday session guest"
              />
            </div>
            <div class="roomopts-link-editor-actions">
              <button type="button" name="invitecreate">Create invite link</button>
              <button type="button" name="invitelimitsclose">Close</button>
            </div>
          </div>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-section-title">
            Active invites
            <span class="roomopts-section-count" name="invitecap"></span>
          </div>
          <div class="roomopts-invite-list-wrap">
            <table class="roomopts-link-table roomopts-invite-table">
              <thead>
                <tr>
                  <th>Link</th>
                  <th>Uses</th>
                  <th>Expires</th>
                  <th></th>
                </tr>
              </thead>
              <tbody name="invitetbody"></tbody>
            </table>
            <p class="roomopts-link-empty" name="inviteempty">
              No guest invites yet.
            </p>
          </div>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-section-title">Invite activity</div>
          <p class="roomopts-hint">
            Recent create, redeem, and revoke events. Tokens and guest
            identifiers are not stored in this audit.
          </p>
          <div class="roomopts-invite-list-wrap">
            <table class="roomopts-link-table roomopts-invite-audit-table">
              <thead>
                <tr>
                  <th>Event</th>
                  <th>Invite</th>
                  <th>Uses</th>
                  <th>Actor</th>
                  <th>When</th>
                </tr>
              </thead>
              <tbody name="inviteaudittbody"></tbody>
            </table>
            <p class="roomopts-link-empty" name="inviteauditempty">
              No guest invite activity yet.
            </p>
          </div>
        </div>
      </div>

      <div
        class="roomopts-panel roomopts-panel-plugins hidden"
        data-roomopts-panel="plugins"
        role="tabpanel"
      >
        <div class="roomopts-section">
          <div class="roomopts-section-title">Bots &amp; plugins</div>
          <p class="roomopts-hint">
            Invite automation bots from the server registry into
            <em>this</em> room. Invited bots upload with a cyan
            <strong>BOT</strong> pill. Settings are stored per room.
          </p>
          <div class="roomopts-plugin-catalog">
            <div class="roomopts-field">
              <label for="roomopts-plugin-pick">Available bots</label>
              <div class="roomopts-plugin-invite-row">
                <select id="roomopts-plugin-pick" name="pluginpick">
                  <option value="">Loading catalog…</option>
                </select>
                <button type="button" name="plugininvite">Invite</button>
              </div>
            </div>
            <p class="roomopts-hint roomopts-plugin-desc" name="plugindesc"></p>
          </div>
        </div>

        <div class="roomopts-plugin-editor hidden" name="plugineditor">
          <div class="roomopts-link-editor-title">
            Bot settings —
            <span name="plugineditorlabel"></span>
          </div>
          <div class="roomopts-plugin-editor-fields" name="plugineditorfields"></div>
          <p
            class="roomopts-rule-error hidden"
            name="pluginvalidation"
            role="alert"
          ></p>
          <div class="roomopts-checks">
            <label
              ><input type="checkbox" name="pluginenabled" checked />
              Enabled in this room</label
            >
          </div>
          <div class="roomopts-link-editor-actions">
            <button type="button" name="pluginapply">Save settings</button>
            <button type="button" name="pluginrun">Run now</button>
            <button type="button" name="pluginrevoke">Remove</button>
            <button type="button" name="pluginclose">Close</button>
          </div>
          <p
            class="roomopts-hint roomopts-plugin-status"
            name="pluginstatus"
            aria-live="polite"
          ></p>
        </div>

        <div class="roomopts-section">
          <div class="roomopts-section-title">Invited in this room</div>
          <div class="roomopts-plugin-list-wrap">
            <table class="roomopts-link-table roomopts-plugin-table">
              <thead>
                <tr>
                  <th>Bot</th>
                  <th>Status</th>
                  <th>Settings</th>
                  <th></th>
                </tr>
              </thead>
              <tbody name="plugintbody"></tbody>
            </table>
            <p class="roomopts-link-empty" name="pluginempty">
              No bots invited yet. Pick one from the catalog above.
            </p>
          </div>
        </div>
      </div>
    </div>
  </form>

  <form id="users-tmpl" class="tmpl">
    <span class="icon i-white"></span>
    <div class="usersdesc wide"></div>
    <label>Add User</label>
    <input name="name" type="text" autocomplete="off" />
    <label>Current</label>
    <div class="userlist"></div>
  </form>

  <template id="help-tmpl">
    <span class="icon i-sytem32"></span>
    <section>
      <h4>Commands for Everyone</h4>
      <dl>
        <dt>/login</dt>
        <dd>Show the login dialog</dd>
        <dt>/nick NAME</dt>
        <dd>Change your nick name</dd>
        <dt>/me MESSAGE</dt>
        <dd>Send a me message</dd>
        <dt>/p <em>USER</em> MESSAGE</dt>
        <dd>Send a private message to a registered user</dd>
        <dt>/motd</dt>
        <dd>Show the MOTD</dd>
        <dt>/search EXPRESSION</dt>
        <dd>Search the file list</dd>
      </dl>
      <p>To just send a message starting with a "/" just use a "//" instead.</p>
    </section>
    <section id="help-modal-regular">
      <h4>Commands for logged in users</h4>
      <dl>
        <dt>/logout</dt>
        <dd>Byeeeeeee</dd>
        <dt>/changepw</dt>
        <dd>Change your password</dd>
      </dl>
    </section>
    <section id="help-modal-owner">
      <h4>Room owners only</h4>
      <dl>
        <dt>/name NAME</dt>
        <dd>Set the room name</dd>
        <dt>/setmotd MOTD</dt>
        <dd>Set the room MOTD</dd>
        <dt>/addowner /removeowner USER</dt>
        <dd>Add/Remove a room owner</dd>
        <dt>/addinvitee /removeinvitee USER</dt>
        <dd>Add/remove an invited user</dd>
      </dl>
    </section>
    <section id="help-modal-mod">
      <h4>Moderators only</h4>
      <dl>
        <dt>/a MESSAGE</dt>
        <dd>Send a message to admin chat only</dd>
      </dl>
    </section>
  </template>

  <template id="welcome">
    <section class="welcome">
      <button
        class="welcome_toggle"
        type="button"
        aria-controls="welcome-details"
        aria-expanded="true"
        aria-label="Minimize room banner"
        title="Minimize room banner"
      >
        <span class="welcome_toggle_icon" aria-hidden="true">−</span>
      </button>
      <div class="welcome_header">
        <h4>Welcome to <%=NAME%></h4>
        <h5><%=MOTTO%></h5>
      </div>
      <div id="welcome-details" class="welcome_details">
        <form class="welcome_namewrap hidden" action="javascript:">
          <p class="welcome_namelabel">Name this room</p>
          <p class="welcome_namecont">
            <input
              class="welcome_nameinput"
              type="text"
              maxlength="20"
              placeholder="Name this room"
              aria-label="Name this room"
            />
            <button
              class="welcome_namebtn icon i-upload-done"
              type="submit"
              title="Set room name"
              aria-label="Set room name"
            ></button>
          </p>
        </form>
        <p class="welcome_intro">
          This room combines chat and temporary file sharing. Files auto-expire
          after <span class="welcome_ttl"></span> hours. Until then, everyone
          here can view, download, and link them. Share this room link to
          collaborate:
        </p>
        <div class="welcome_linkwrap">
          <p class="welcome_linkcont">
            <span class="welcome_link"></span>
            <a class="welcome_copy icon i-copy" title="Copy link"></a>
          </p>
        </div>
        <div class="welcome_motd_wrap hidden">
          <div class="welcome_motd"></div>
        </div>
        <p class="welcome_tos">
          By using <%=NAME%> you agree to our
          <a href="/terms" target="_blank"
            >Terms of Service and Privacy policy</a
          >, and our <a href="/rules" target="_blank">Rules</a>.
        </p>
      </div>
    </section>
  </template>

  <script>
    window.__CV__ = "<%- v %>";
  </script>
  <script src="/client.js?v=<%=v%>"></script>
</body>
