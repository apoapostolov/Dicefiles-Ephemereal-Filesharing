{
  "name": "dicefiles",
  "version": "1.4.3",
  "description": "Ephemereal Filesharing for Hobby Communities",
  "main": "server.js",
  "author": "RealDolos <dolos@cock.li>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "webpack --mode=production",
    "pack": "yarn build",
    "postinstall": "node ./scripts/check-preview-tools.js --warn",
    "setup:ubuntu": "bash ./scripts/setup-ubuntu.sh",
    "check:preview-tools": "node ./scripts/check-preview-tools.js",
    "backfill:previews": "node ./scripts/backfill-previews.js",
    "prestart": "yarn build",
    "start": "node server.js",
    "restart": "sh ./scripts/restart-server.sh",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules ./node_modules/.bin/jest tests/unit tests/views",
    "test:integration": "node --experimental-vm-modules ./node_modules/.bin/jest tests/integration",
    "test:coverage": "node --experimental-vm-modules ./node_modules/.bin/jest --coverage"
  },
  "dependencies": {
    "@fedify/fedify": "^2.3.3",
    "@lingo-reader/mobi-parser": "^0.4.5",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.1.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "file-loader": "^6.2.0",
    "helmet": "^7.2.0",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lru-cache": "^10.4.3",
    "mini-css-extract-plugin": "^2.9.2",
    "notepack.io": "^3.0.1",
    "passlib": "^0.3.0",
    "pdfjs-dist": "^3.11.174",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "socket.io-parser": "^4.2.4",
    "speakeasy": "^2.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "url-loader": "^4.1.1",
    "url-regex-safe": "^4.0.0",
    "uuid": "^9.0.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "xregexp": "^5.1.1",
    "yauzl": "^2.10.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "gm": "^1.25.1",
    "megajs": "^1.3.10"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "stylelint-config-recommended": "^5.0.0",
    "supertest": "^7.0.0"
  }
}
