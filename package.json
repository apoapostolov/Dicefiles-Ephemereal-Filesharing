{
  "name": "hobbyfiles",
  "version": "1.5.0",
  "description": "Ephemereal Filesharing for Hobby Communities",
  "main": "server.js",
  "author": "RealDolos <dolos@cock.li>",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "webpack --mode=production",
    "pack": "yarn build",
    "postinstall": "node ./scripts/check-preview-tools.js --warn",
    "setup:ubuntu": "bash ./scripts/setup-ubuntu.sh",
    "check:preview-tools": "node ./scripts/check-preview-tools.js",
    "check:torrent-runtime": "node ./scripts/check-torrent-runtime.js",
    "backfill:previews": "node ./scripts/backfill-previews.js",
    "federation:key": "node ./scripts/federation-key.js",
    "prestart": "yarn build",
    "start": "node server.js",
    "restart": "sh ./scripts/restart-server.sh",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit tests/views",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration",
    "test:federation": "node ./scripts/federation-two-host-smoke.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "audit:production": "node scripts/audit-dependencies.js --production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "@babylonjs/viewer": "^9.30.0",
    "@fedify/fedify": "^2.3.4",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "argon2": "^0.45.1",
    "babylonjs-gltf2interface": "9.31.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lru-cache": "^11.5.3",
    "notepack.io": "^3.0.1",
    "pdfjs-dist": "^6.4.299",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "send": "^1.2.1",
    "serve-static": "^2.2.1",
    "shaka-player": "^5.2.13",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "socket.io-parser": "^4.2.4",
    "speakeasy": "^2.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "url-regex-safe": "^4.0.0",
    "webtorrent": "^3.0.21",
    "xregexp": "^5.1.1",
    "yauzl": "^3.4.0",
    "zod": "^4.2.0"
  },
  "optionalDependencies": {
    "megajs": "^1.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.9.2",
    "supertest": "^7.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.3"
  },
  "resolutions": {
    "bittorrent-tracker": "file:vendor/bittorrent-tracker",
    "webrtc-polyfill": "file:vendor/webrtc-disabled",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "engine.io": "6.6.11",
    "express-rate-limit": "8.6.1",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "qs": "6.16.0",
    "**/router/path-to-regexp": "8.4.2",
    "ws": "8.22.0",
    "**/@istanbuljs/load-nyc-config/js-yaml": "4.3.2"
  }
}
