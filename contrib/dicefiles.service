[Unit]
Description=Dicefiles Ephemeral Filesharing
After=network-online.target
Wants=network-online.target
# If Redis is provided by a companion unit, uncomment:
# After=dicefiles-redis.service
# Requires=dicefiles-redis.service

[Service]
Type=simple
# Adjust paths for your install
WorkingDirectory=/mnt/c/git-public/Dicefiles-Ephemereal-Filesharing
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Port is taken from .config.json (set "port": 10005)
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dicefiles

[Install]
WantedBy=multi-user.target
# For user systemd: WantedBy=default.target and place under ~/.config/systemd/user/
