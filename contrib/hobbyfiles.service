[Unit]
Description=Hobbyfiles Ephemeral Filesharing
After=network-online.target
Wants=network-online.target
# If Redis is provided by a companion unit, uncomment:
# After=hobbyfiles-redis.service
# Requires=hobbyfiles-redis.service

[Service]
Type=simple
# Adjust paths for your install
WorkingDirectory=/path/to/Hobbyfiles
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Port is taken from .config.json (set "port": 10005)
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hobbyfiles

[Install]
WantedBy=multi-user.target
Alias=dicefiles.service
# For user systemd: change WantedBy to default.target and install under ~/.config/systemd/user/.
# Existing dicefiles.service installs can keep their current unit until they are migrated.
