# Dicefiles runtime environment. Copy to .env; never commit the filled file.
# Process/service variables override .env; env overrides .config/.config.json.
# Restart after changes. Values are not evaluated as shell commands.

# 1. Runtime and network
# NODE_ENV=production
# HTTP_PORT=8080
# HTTPS_PORT=8443
# DICEFILES_WORKERS=2
# DICEFILES_NAME=Dicefiles
# DICEFILES_MOTTO=Ephemeral filesharing for hobby communities
# DICEFILES_PUBLIC_BASE_URL=https://files.example.org

# 2. Private signing and status credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DICEFILES_SECRET=
# DICEFILES_STATUS_PRIVATE=true
# Optional 48-128 hexadecimal characters; generated privately when omitted.
# DICEFILES_STATUS_TOKEN=

# 3. Data and Redis (Redis must remain private)
# DICEFILES_UPLOADS=uploads
# REDIS_URL=redis://127.0.0.1:6379/0
# DICEFILES_JAIL=true
# DICEFILES_NATIVE_TOOLS=true

# 4. Feature flags (strict true/false)
# DICEFILES_PUBLIC_ROOMS=false
# DICEFILES_LINK_COLLECTION=true
# Public tracker/DHT/peer metadata lookups; never downloads torrent contents.
# DICEFILES_TORRENT_DISCOVERY=true

# 5. Provider keys (server only; never embedded in browser assets)
# DICEFILES_GIPHY_API_KEY=
# DICEFILES_OPENGRAPH_API_KEY=

# 6. Automation (JSON array; use least-privilege scopes)
# DICEFILES_AUTOMATION_KEYS='[{"id":"reader","key":"replace-me","scopes":["files:read"]}]'

# 7. Optional standalone MCP process (see MCP.md for OAuth configuration)
# DICEFILES_BASE_URL=http://127.0.0.1:8080
# DICEFILES_API_KEY=
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=3001
# MCP_API_TIMEOUT_MS=30000
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=
# MCP_OAUTH_CONFIG=
