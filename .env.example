# Hobbyfiles runtime environment. Copy to .env; never commit the filled file.
# Process/service variables override .env; env overrides .config/.config.json.
# Restart after changes. Values are not evaluated as shell commands.

# 1. Runtime and network
# NODE_ENV=production
# HTTP_PORT=8080
# HTTPS_PORT=8443
# HOBBYFILES_WORKERS=2
# HOBBYFILES_NAME=Hobbyfiles
# HOBBYFILES_MOTTO=Ephemeral filesharing for hobby communities
# HOBBYFILES_PUBLIC_BASE_URL=https://files.example.org

# 2. Private signing and status credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HOBBYFILES_SECRET=
# HOBBYFILES_STATUS_PRIVATE=true
# Optional 48-128 hexadecimal characters; generated privately when omitted.
# HOBBYFILES_STATUS_TOKEN=

# 3. Data and Redis (Redis must remain private)
# HOBBYFILES_UPLOADS=uploads
# REDIS_URL=redis://127.0.0.1:6379/0
# HOBBYFILES_JAIL=true
# HOBBYFILES_NATIVE_TOOLS=true

# 4. Feature flags (strict true/false)
# HOBBYFILES_PUBLIC_ROOMS=false
# HOBBYFILES_LINK_COLLECTION=true
# Public tracker/DHT/peer metadata lookups; never downloads torrent contents.
# HOBBYFILES_TORRENT_DISCOVERY=true
# Relaxed tracker-only availability checks; requires torrent discovery above.
# HOBBYFILES_TORRENT_MONITOR=true
# Video playback fetches selected public torrent pieces only when Play is used.
# Disable independently of metadata discovery; see docs/MOVIES.md for limits.
# HOBBYFILES_TORRENT_PLAYBACK=true
# Match torrent video filenames in the background using configured catalogues.
# High-confidence results apply automatically; manual choices always win.
# HOBBYFILES_MOVIE_AUTO_MATCH=true

# 5. Provider keys (server only; never embedded in browser assets)
# HOBBYFILES_GIPHY_API_KEY=
# HOBBYFILES_OPENGRAPH_API_KEY=
# Movie metadata: TMDB read token preferred; API key is an alternative.
# HOBBYFILES_TMDB_TOKEN=
# HOBBYFILES_TMDB_API_KEY=
# Optional TVDB v4 key and subscriber PIN, if required by its license.
# HOBBYFILES_TVDB_API_KEY=
# HOBBYFILES_TVDB_PIN=
# Optional Trakt application client ID (public catalogue reads only).
# HOBBYFILES_TRAKT_CLIENT_ID=

# 6. Automation (JSON array; use least-privilege scopes)
# HOBBYFILES_AUTOMATION_KEYS='[{"id":"reader","key":"replace-me","scopes":["files:read"]}]'
# Bot connections are operator-owned grants. Room settings store only their ID.
# See core/plugins/COLLECTION_BOTS.md for provider settings and read-only scopes.
# HOBBYFILES_PLUGIN_CONNECTIONS='[{"id":"team-drive","provider":"drive","label":"Team files","pluginIds":["drive-collection"],"roomIds":["your-room-id"],"credentials":{"accessTokenEnv":"TEAM_DRIVE_TOKEN"},"settings":{"folderIds":["approved-folder-id"]}}]'
# TEAM_DRIVE_TOKEN=

# 7. Optional standalone MCP process (see MCP.md for OAuth configuration)
# HOBBYFILES_BASE_URL=http://127.0.0.1:8080
# HOBBYFILES_API_KEY=
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=3001
# MCP_API_TIMEOUT_MS=30000
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=
# MCP_OAUTH_CONFIG=
