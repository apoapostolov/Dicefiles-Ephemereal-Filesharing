# Copy to .env.docker. Use docker compose --env-file .env.docker ...
# Generate a private signing secret: openssl rand -hex 32
HOBBYFILES_SECRET=
HOBBYFILES_HOST_PORT=8080
HOBBYFILES_IMAGE=hobbyfiles:local
# Server-only provider key (optional):
HOBBYFILES_GIPHY_API_KEY=
# External tools are disabled in the image until a sandbox policy is validated.
# Do not enable this for public uploads without working isolation.
HOBBYFILES_NATIVE_TOOLS=false
HOBBYFILES_JAIL=true
# Optional public tracker/DHT/peer metadata lookup. No torrent payload downloads.
HOBBYFILES_TORRENT_DISCOVERY=true
# Relaxed tracker-only checks; requires discovery above.
HOBBYFILES_TORRENT_MONITOR=true
# Payload playback uses temporary disk space. Enable only with a disk-backed
# streaming cache; the default Compose /tmp is a 512 MiB memory filesystem.
HOBBYFILES_TORRENT_PLAYBACK=false
# Background title matching sends torrent video filenames to configured providers.
HOBBYFILES_MOVIE_AUTO_MATCH=true
# Optional movie catalogue credentials:
HOBBYFILES_TMDB_TOKEN=
HOBBYFILES_TMDB_API_KEY=
HOBBYFILES_TVDB_API_KEY=
HOBBYFILES_TVDB_PIN=
HOBBYFILES_TRAKT_CLIENT_ID=
